{
  "framework": "nextjs",
  "outputDirectory": ".next",
  "headers": [
    {
      "source": "/api/governance(.*)",
      "headers": [
        {
          "key": "X-Aurion-Governance",
          "value": "mav-2.1.0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/governance",
      "destination": "/api/governance"
    }
  ]
}
