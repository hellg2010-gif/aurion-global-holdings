{
  "name": "aurion-global",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "eslint",
    "test": "npm run test:governance && npm run test:governance-runtime && npm run test:hub-stub && npm run test:cloudflare-config",
    "test:governance": "npm test --prefix packages/aurion-governance-mav",
    "ci:verify-run": "npm run ci:verify-run --prefix packages/aurion-governance-mav",
    "test:governance-runtime": "node --test tests/governance-runtime.test.mjs",
    "test:scaffold": "node --test tests/orchestration-scaffold.test.ts",
    "test:hub-stub": "node --test tests/hub-v0.1-stub.test.mjs",
    "test:cloudflare-config": "node --test tests/cloudflare-deployment.test.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
